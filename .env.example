GOOGLE_CALENDAR_ID=XXX@group.calendar.google.com
# Локально можно указать путь к файлу ключа сервисного аккаунта Google.
# deploy/deploy.ps1 преобразует файл в base64 и передаёт его
# в переменную окружения GOOGLE_SERVICE_ACCOUNT_JSON обеих функций.
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=myagent-XXX.json
RUBITIME_API_KEY=XXX
RUBITIME_BRANCH_ID=123
RUBITIME_COOPERATOR_ID=123
RUBITIME_SERVICE_ID=123
RUBITIME_ONLY_AVAILABLE=true
EVENT_TIMEZONE=Europe/Moscow
EVENT_LOCATION=Москва
GOOGLE_EVENT_COLOR_ID=5
# Google Calendar color ID for records longer than 60 minutes (9 = blueberry/blue).
GOOGLE_LONG_EVENT_COLOR_ID=9
CALENDAR_SUMMARY_TEMPLATE={payment_icon} {name}
LOG_LEVEL=INFO
